NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/kart-nard
# Append to existing .env and .env.example (do not commit real secrets).
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-random-secret
OTP_SECRET=replace-with-different-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=your-email@example.com
TRUST_PROXY=0

SKIP_EMAIL_VERIFICATION=true

FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000
